<Project>

  <!--
    Copies the bundled ONNX models (models/README.md) next to the executable, so PhotoBook.Analysis
    finds them at AppContext.BaseDirectory\models and face detection plus saliency work with no
    setup step. Opt in with <BundleOnnxModels>true</BundleOnnxModels>; only projects that actually
    run - the app and the test project - need them, and copying 4.6 MB into every class library's
    output would be waste.

    Missing files are not an error: OnnxAnalyzer reports what it found and falls back to the
    classical pipeline for the rest, which is how the unbundled NIMA stage behaves.
  -->
  <ItemGroup Condition="'$(BundleOnnxModels)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)models\*.onnx"
          Link="models\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!--
    Copies a developer's own onedrive.json from the repository root next to the executable, where
    OneDriveConfigurationLoader looks for it. This is the "clone and drop one file in" path from
    SETUP.md: the client id is a per-machine setting, so the file is git-ignored and simply absent
    for most builds — Exists() keeps that a no-op rather than an error.

    Deliberately NOT opted into by the test project. OneDriveConfigurationTests writes its own file
    into the output directory to prove the search order, and a developer's real config landing there
    would make that test pass or fail depending on whose machine it ran on.
  -->
  <ItemGroup Condition="'$(BundleOneDriveConfig)' == 'true' And Exists('$(MSBuildThisFileDirectory)onedrive.json')">
    <None Include="$(MSBuildThisFileDirectory)onedrive.json"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
