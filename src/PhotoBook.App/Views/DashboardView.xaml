<UserControl x:Class="PhotoBook.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pb="clr-namespace:PhotoBook.App.Controls"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave">
    <Grid Background="{DynamicResource CanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="64,56,64,56" MaxWidth="1040" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <pb:Icon Data="{StaticResource Icon.AppMark}" Width="34" Height="34"
                                 Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="PhotoBook" Style="{StaticResource DisplayTextStyle}"
                                   Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySecondaryTextStyle}" Margin="0,14,0,0"
                               MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Photo books that lay themselves out. Point it at a year of photos and an optional journal, and it builds the pages — you just nudge what you want changed." />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,36,0,0">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewBookCommand}" Padding="20,11">
                        <StackPanel Orientation="Horizontal">
                            <pb:Icon Data="{StaticResource Icon.New}" VerticalAlignment="Center" />
                            <TextBlock Text="New book" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"
                            Command="{Binding OpenBookCommand}" Padding="20,11">
                        <StackPanel Orientation="Horizontal">
                            <pb:Icon Data="{StaticResource Icon.FolderOpen}" VerticalAlignment="Center" />
                            <TextBlock Text="Open book" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,48,0,0" VerticalAlignment="Top">
                    <!-- First run: nothing to list yet, so explain the next step. -->
                    <Border Style="{StaticResource WellStyle}" Padding="32" VerticalAlignment="Top"
                            Visibility="{Binding HasRecent, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <pb:Icon Data="{StaticResource Icon.PhotoPlus}" Width="30" Height="30"
                                     Foreground="{DynamicResource TextTertiaryBrush}"
                                     HorizontalAlignment="Left" />
                            <TextBlock Text="No books yet" Style="{StaticResource SubtitleTextStyle}"
                                       Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource BodySecondaryTextStyle}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                       Text="Start a book, then import a folder of photos. PhotoBook reads the dates, works out which pictures matter, and lays out each month for you. You can also drop a folder anywhere on this window." />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="RECENT BOOKS" Style="{StaticResource SectionLabelTextStyle}" />
                        <ItemsControl ItemsSource="{Binding Recent}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding DataContext.OpenRecentCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,14,14" Padding="0" HorizontalContentAlignment="Stretch">
                                        <Border Style="{StaticResource CardStyle}" Width="248" Padding="18">
                                            <StackPanel>
                                                <pb:Icon Data="{StaticResource Icon.Book}" Width="22" Height="22"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Title}" Margin="0,14,0,0"
                                                           Style="{StaticResource BodyStrongTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Year}" Margin="0,3,0,0"
                                                           Style="{StaticResource CaptionMutedTextStyle}" />
                                                <TextBlock Text="{Binding Folder}" Margin="0,10,0,0"
                                                           Style="{StaticResource MicroTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border x:Name="DropHint" Visibility="Collapsed" Margin="24"
                Background="{DynamicResource ScrimBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <pb:Icon Data="{StaticResource Icon.Import}" Width="40" Height="40"
                         Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Drop a folder to open or create a book"
                           Style="{StaticResource TitleTextStyle}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
