<UserControl x:Class="PhotoBook.App.Views.Export.ExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pb="clr-namespace:PhotoBook.App.Controls"
             xmlns:conv="clr-namespace:PhotoBook.App.Converters"
             xmlns:export="clr-namespace:PhotoBook.App.Views.Export"
             xmlns:rend="clr-namespace:PhotoBook.Rendering;assembly=PhotoBook.Rendering"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="ScopeIsBook" Match="{x:Static rend:ExportScopeKind.Book}" />
        <conv:EnumMatchConverter x:Key="ScopeIsChapter" Match="{x:Static rend:ExportScopeKind.Chapter}" />
        <conv:EnumMatchConverter x:Key="ScopeIsRange" Match="{x:Static rend:ExportScopeKind.PageRange}" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="392" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- ==================================================== left: scope + action -->
        <DockPanel Grid.Column="0">

            <!-- footer: the two buttons doc 12 specifies -->
            <Border DockPanel.Dock="Bottom" Padding="20,16"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <StackPanel>

                    <!-- progress while writing -->
                    <StackPanel Margin="0,0,0,14"
                                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding Progress, StringFormat='{}{0:F0}%'}" HorizontalAlignment="Right"
                                       Style="{StaticResource CaptionMutedTextStyle}" />
                        </Grid>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,7,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Height="38"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <pb:Icon Data="{StaticResource Icon.Export}" VerticalAlignment="Center" />
                            <TextBlock Text="Export PDF" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ExportDraftCommand}"
                                ToolTip="Skips preflight. 150 DPI, JPEG q75, DRAFT watermark — for proofing on screen, never for upload.">
                            <StackPanel Orientation="Horizontal">
                                <pb:Icon Data="{StaticResource Icon.Eye}" VerticalAlignment="Center" />
                                <TextBlock Text="Draft PDF" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Margin="9,0,0,0"
                                Content="Close" Command="{Binding CloseCommand}" MinWidth="86" />
                    </Grid>

                    <!-- errors block; say so where the button is rather than in a dialog -->
                    <TextBlock Margin="2,10,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="Export is blocked until the errors on the right are fixed. Draft PDF still works."
                               Visibility="{Binding Preflight.ErrorCount, Converter={StaticResource CountToVisibility}}" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,16,18">
                <StackPanel>

                    <TextBlock Text="Export" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Style="{StaticResource ParagraphTextStyle}" Margin="0,6,0,0" MaxWidth="340"
                               Text="The same renderer draws the screen and the PDF, so what you have been proofing is what prints." />

                    <!-- ======================================================= scope -->
                    <TextBlock Text="Scope" Style="{StaticResource SectionLabelTextStyle}" Margin="0,22,0,8" />

                    <Border Style="{StaticResource SegmentedGroupStyle}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="ExportScope"
                                         Content="Whole book"
                                         IsChecked="{Binding ScopeKind, Converter={StaticResource ScopeIsBook}}" />
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="ExportScope"
                                         Content="This chapter"
                                         IsChecked="{Binding ScopeKind, Converter={StaticResource ScopeIsChapter}}" />
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="ExportScope"
                                         Content="Page range"
                                         IsChecked="{Binding ScopeKind, Converter={StaticResource ScopeIsRange}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ScopeSummary}" Style="{StaticResource CaptionMutedTextStyle}"
                               Margin="2,10,0,0" TextWrapping="Wrap" MaxWidth="340" />

                    <!-- chapter picker -->
                    <ComboBox Margin="0,12,0,0" ItemsSource="{Binding Chapters}"
                              SelectedItem="{Binding SelectedChapter}" DisplayMemberPath="Label"
                              Visibility="{Binding IsChapterScope, Converter={StaticResource BoolToVisibility}}" />

                    <!-- page range -->
                    <Grid Margin="0,12,0,0"
                          Visibility="{Binding IsPageRangeScope, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="From page" Style="{StaticResource MicroTextStyle}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding FirstPage, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Bottom" Margin="10,0,10,7"
                                   Style="{StaticResource BodySecondaryTextStyle}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="To page" Style="{StaticResource MicroTextStyle}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding LastPage, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                        </StackPanel>
                    </Grid>

                    <!-- proof note -->
                    <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Visibility="{Binding IsProofOnly, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <pb:Icon Data="{StaticResource Icon.Info}" VerticalAlignment="Top" Margin="0,2,0,0"
                                     Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Margin="9,0,0,0" TextWrapping="Wrap" MaxWidth="286"
                                       Style="{StaticResource CaptionMutedTextStyle}"
                                       Text="Partial exports are proofs, not uploads: the printer's page-count rules are only enforced on a whole-book export." />
                        </StackPanel>
                    </Border>

                    <!-- ================================================= destination -->
                    <TextBlock Text="Destination" Style="{StaticResource SectionLabelTextStyle}" Margin="0,24,0,8" />

                    <Border Style="{StaticResource WellStyle}" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <pb:Icon Grid.Column="0" Data="{StaticResource Icon.Export}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock Text="{Binding OutputFileName}" Style="{StaticResource BodyTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding OutputFolder}" Style="{StaticResource CaptionMutedTextStyle}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="Change…"
                                    Command="{Binding BrowseCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- ====================================================== result -->
                    <Border Margin="0,20,0,0" Padding="14,12" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <pb:Icon Data="{StaticResource Icon.Check}" VerticalAlignment="Top" Margin="0,2,0,0"
                                         Foreground="{DynamicResource SuccessBrush}"
                                         Visibility="{Binding ResultIsSuccess, Converter={StaticResource BoolToVisibility}}" />
                                <pb:Icon Data="{StaticResource Icon.Warning}" VerticalAlignment="Top" Margin="0,2,0,0"
                                         Foreground="{DynamicResource ErrorBrush}"
                                         Visibility="{Binding ResultIsSuccess, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="{Binding ResultMessage}" Margin="10,0,0,0" TextWrapping="Wrap"
                                           MaxWidth="286" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ResultNotes}" Margin="26,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="286" Margin="0,0,0,4"
                                                   Style="{StaticResource CaptionMutedTextStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="26,10,0,0"
                                        Visibility="{Binding ResultIsSuccess, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource LinkButtonStyle}" Content="Open PDF"
                                        Command="{Binding OpenResultCommand}" />
                                <Button Style="{StaticResource LinkButtonStyle}" Content="Show in folder"
                                        Margin="14,0,0,0" Command="{Binding ShowInFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- =========================================================== right: gate -->
        <export:PreflightPanel Grid.Column="1" DataContext="{Binding Preflight}" />
    </Grid>
</UserControl>
