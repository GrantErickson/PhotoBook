<UserControl x:Class="PhotoBook.App.Views.Photos.PhotoInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pb="clr-namespace:PhotoBook.App.Controls"
             xmlns:photos="clr-namespace:PhotoBook.App.Views.Photos">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PhotoBook.App;component/Themes/PhotoEditing.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">

        <!-- Why a drop was refused. Lives here rather than over the grid so it never covers a tile
             mid-drag, and it clears itself the moment the pointer leaves. -->
        <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource AmberFlagWashBrush}"
                BorderBrush="{DynamicResource AmberFlagBrush}" BorderThickness="1"
                Visibility="{Binding Reorder.HasHint, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Reorder.Hint}" Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ============================================ date (R6, §2.1) -->
        <TextBlock Text="Date" Style="{StaticResource SectionLabelTextStyle}" />
        <TextBlock Text="{Binding DateLabel}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ProvenanceLabel}" Style="{StaticResource CaptionMutedTextStyle}"
                   Margin="0,3,0,0" />

        <Border Style="{StaticResource AmberBadgeStyle}" Margin="0,8,0,0" HorizontalAlignment="Left"
                Visibility="{Binding IsDateUncertain, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Date guessed from the file" />
        </Border>

        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0"
                HorizontalAlignment="Left" Command="{Binding ChangeDateCommand}"
                ToolTip="Re-date this photo (D). A new month moves it to that month's Unplaced bin.">
            <StackPanel Orientation="Horizontal">
                <pb:Icon Data="{StaticResource Icon.Calendar}" VerticalAlignment="Center" />
                <TextBlock Text="Change date…" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Border Style="{StaticResource DividerStyle}" Margin="0,20,0,0" />

        <!-- ============================================ focus (R25, §2.2) -->
        <TextBlock Text="Focus" Style="{StaticResource SectionLabelTextStyle}" Margin="0,20,0,0" />

        <Border CornerRadius="6" Background="{DynamicResource FocusSurfaceBrush}" Height="150"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" ClipToBounds="True">
            <pb:FocusRegionSurface IsInteractive="False"
                                   Image="{Binding Focus.Preview}"
                                   Regions="{Binding Focus.Regions}" />
        </Border>

        <TextBlock Text="{Binding FocusSummary}" Style="{StaticResource CaptionMutedTextStyle}"
                   Margin="0,8,0,0" TextWrapping="Wrap" />

        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0"
                HorizontalAlignment="Left" Command="{Binding EditFocusCommand}"
                ToolTip="Draw or adjust what smart crop must keep in frame (F)">
            <StackPanel Orientation="Horizontal">
                <pb:Icon Data="{StaticResource Icon.FocusTarget}" VerticalAlignment="Center" />
                <TextBlock Text="Edit focus areas…" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Border Style="{StaticResource DividerStyle}" Margin="0,20,0,0" />

        <!-- ============================================ adjust (R11, §2.4) -->
        <photos:AdjustmentsPanel Margin="0,20,0,0" DataContext="{Binding Adjustments}" />

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionMutedTextStyle}"
                   Margin="0,16,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
