<Window xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="PhotoBook.App.Views.Photos.ChangeDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pb="clr-namespace:PhotoBook.App.Controls"
        Title="Change date"
        SizeToContent="Height" Width="420" MinWidth="380"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ShowInTaskbar="False" ResizeMode="NoResize"
        shell:WindowChrome.WindowChrome="{StaticResource FixedWindowChrome}"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- A calendar cell. Its own template rather than a themed button, because the states here
             (selected, today, padding day) are not the states a command button has. -->
        <Style x:Key="CalendarDayStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="Fill" CornerRadius="{StaticResource RadiusSmall}"
                                    Background="Transparent" />
                            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource RadiusSmall}"
                                    Background="{StaticResource HoverOverlayBrush}" />
                            <Border x:Name="TodayRing" Opacity="0" CornerRadius="{StaticResource RadiusSmall}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                            <Border x:Name="FocusRing" Opacity="0" CornerRadius="{StaticResource RadiusSmall}"
                                    BorderBrush="{StaticResource FocusRingBrush}" BorderThickness="1.5" />
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter TargetName="Content" Property="Opacity" Value="0.35" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="TodayRing" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The outcome banner: quiet when the photo stays put, amber when it moves month, and
             loudest when it leaves the book's year entirely (doc 09 §2.1). -->
        <Style x:Key="OutcomeBannerStyle" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OutcomeIsMove}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberFlagWashBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AmberFlagBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OutcomeLeavesBook}" Value="True">
                    <Setter Property="Background" Value="{StaticResource WarningWashBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <DockPanel>

            <!-- header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBarBrush}"
                    Padding="18,14" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Change date" Style="{StaticResource SubtitleTextStyle}" />
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource CaptionMutedTextStyle}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Style="{StaticResource SmallIconButtonStyle}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Command="{Binding CancelCommand}" ToolTip="Close">
                        <pb:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- footer -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="Cancel" MinWidth="90"
                            Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="130"
                            Content="Change date" Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding CanApply}" />
                </StackPanel>
            </Border>

            <!-- body -->
            <StackPanel Margin="18,16,18,16">

                <!-- what it says now -->
                <Border Style="{StaticResource WellStyle}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Currently" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding CurrentDateLabel}" Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ProvenanceLabel}" Style="{StaticResource CaptionMutedTextStyle}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Border Style="{StaticResource AmberBadgeStyle}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding IsUncertain, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Date guessed from the file" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- calendar -->
                <Grid Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource SmallIconButtonStyle}" Command="{Binding PreviousMonthCommand}"
                                ToolTip="Previous month">
                            <pb:Icon Data="{StaticResource Icon.ChevronLeft}" Width="13" Height="13" />
                        </Button>
                        <TextBlock Text="{Binding DisplayMonthLabel}" Style="{StaticResource BodyStrongTextStyle}"
                                   VerticalAlignment="Center" Margin="8,0,8,0" MinWidth="140"
                                   TextAlignment="Center" />
                        <Button Style="{StaticResource SmallIconButtonStyle}" Command="{Binding NextMonthCommand}"
                                ToolTip="Next month">
                            <pb:Icon Data="{StaticResource Icon.ChevronRight}" Width="13" Height="13" />
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="Today" HorizontalAlignment="Right"
                            Command="{Binding ShowTodayCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding WeekdayNames}" Margin="0,10,0,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MicroTextStyle}"
                                       HorizontalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="6" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CalendarDayStyle}" Content="{Binding Label}"
                                    Command="{Binding DataContext.SelectDayCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- time -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Time of day" Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" HorizontalAlignment="Right" Width="120"
                             Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="9:30 am, 21:30 and 2130 all work" />
                </Grid>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"
                           Foreground="{DynamicResource ErrorBrush}"
                           Text="That is not a time — try 9:30 am or 21:30."
                           Visibility="{Binding IsTimeInvalid, Converter={StaticResource BoolToVisibility}}" />

                <!-- the whole point: what this will do -->
                <Border Style="{StaticResource OutcomeBannerStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ValueLabel}" Style="{StaticResource BodyStrongTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OutcomeMessage}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource MicroTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Setting a date by hand clears the “date guessed” flag. Ctrl+Z undoes the whole move, including any slot it empties." />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
