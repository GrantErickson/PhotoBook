<UserControl x:Class="PhotoBook.App.Views.Photos.AdjustmentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pb="clr-namespace:PhotoBook.App.Controls">
    <UserControl.Resources>

        <!-- One parameter: name, live readout, its own reset, and the track.
             Bipolar parameters get the centre-detented track; 0..1 ones get the filled track, which
             is why both are present and one is collapsed — the two styles carry different templates
             and a slider cannot swap template by trigger. -->
        <DataTemplate x:Key="AdjustmentSliderTemplate">
            <Grid Margin="0,10,0,0" ToolTip="{Binding Hint}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}"
                           Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ValueLabel}"
                           Style="{StaticResource NumericTextStyle}" FontSize="11.5"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="52"
                           TextAlignment="Right" />

                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SmallIconButtonStyle}"
                        Margin="4,0,-4,0" Command="{Binding ResetCommand}"
                        ToolTip="Reset this one"
                        Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}">
                    <pb:Icon Data="{StaticResource Icon.Undo}" Width="13" Height="13" />
                </Button>

                <Slider Grid.Row="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
                        Style="{StaticResource BipolarSliderStyle}"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        SmallChange="{Binding SmallStep}" LargeChange="{Binding LargeStep}"
                        Value="{Binding Value, Mode=TwoWay}"
                        MouseDoubleClick="OnSliderDoubleClick"
                        Visibility="{Binding IsBipolar, Converter={StaticResource BoolToVisibility}}" />

                <Slider Grid.Row="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        SmallChange="{Binding SmallStep}" LargeChange="{Binding LargeStep}"
                        Value="{Binding Value, Mode=TwoWay}"
                        MouseDoubleClick="OnSliderDoubleClick"
                        Visibility="{Binding IsBipolar, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AdjustmentGroupTemplate">
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,0" />
                <ItemsControl ItemsSource="{Binding Sliders}"
                              ItemTemplate="{StaticResource AdjustmentSliderTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>

        <!-- ============================================ header -->
        <Grid>
            <TextBlock Text="Adjust" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,0"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,-4,0,0">
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{Binding ShowOriginal}"
                              ToolTip="Hold to see the photo before your edits">
                    <pb:Icon Data="{StaticResource Icon.Eye}" Width="15" Height="15" />
                </ToggleButton>
                <Button Style="{StaticResource GhostButtonStyle}" Content="Reset all"
                        Command="{Binding ResetAllCommand}" Margin="2,0,0,0"
                        IsEnabled="{Binding HasEdits}"
                        ToolTip="Return every parameter to neutral" />
            </StackPanel>
        </Grid>

        <!-- ============================================ live preview -->
        <Border CornerRadius="6" Background="{DynamicResource PageBlackBrush}" Height="184" Margin="0,10,0,0"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Image Source="{Binding Preview}" Stretch="Uniform" Margin="5" />

                <Border Style="{StaticResource ChipStyle}" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8" Background="{DynamicResource ScrimHeavyBrush}"
                        Visibility="{Binding ShowOriginal, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Before" Style="{StaticResource MicroTextStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="1"
                             Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource MicroTextStyle}" Margin="0,7,0,0" TextWrapping="Wrap"
                   Text="Edits are parameters, not pixels — the original file in originals/ is never written to." />

        <!-- ============================================ geometry -->
        <TextBlock Text="Orientation" Style="{StaticResource SectionLabelTextStyle}" Margin="0,18,0,0" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RotateLeftCommand}"
                    MinWidth="0" Padding="10,4,10,5" ToolTip="Rotate a quarter turn anticlockwise">
                <pb:Icon Data="{StaticResource Icon.Undo}" Width="15" Height="15" />
            </Button>
            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RotateRightCommand}"
                    Margin="6,0,0,0" MinWidth="0" Padding="10,4,10,5" ToolTip="Rotate a quarter turn clockwise">
                <pb:Icon Data="{StaticResource Icon.Redo}" Width="15" Height="15" />
            </Button>
            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FlipCommand}"
                    Margin="6,0,0,0" MinWidth="0" Padding="10,4,10,5" ToolTip="Mirror horizontally">
                <pb:Icon Data="{StaticResource Icon.Spread}" Width="15" Height="15" />
            </Button>
            <TextBlock Text="{Binding RotationLabel}" Style="{StaticResource NumericTextStyle}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <CheckBox Content="Black and white" Margin="0,14,0,0" IsChecked="{Binding IsBlackAndWhite}"
                  ToolTip="Converts to greyscale with the slight contrast lift the print profile expects" />

        <!-- ============================================ the stack -->
        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource AdjustmentGroupTemplate}" />

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionMutedTextStyle}"
                   Margin="0,16,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
