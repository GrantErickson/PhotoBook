<Window xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="PhotoBook.App.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pb="clr-namespace:PhotoBook.App.Controls"
        Title="Keyboard shortcuts"
        Height="820" Width="1000" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ShowInTaskbar="False"
        shell:WindowChrome.WindowChrome="{StaticResource AppWindowChrome}"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- A key cap: the smallest thing that reads as "press this". Mono type, because a key
             legend is a literal, and one step lighter than the card it sits on. -->
        <Style x:Key="KeyCapStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SurfaceHighestBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
            <Setter Property="Padding" Value="7,2,7,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <DataTemplate x:Key="ShortcutRowTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding Caps}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KeyCapStyle}">
                                <TextBlock Text="{Binding}" Style="{StaticResource MonoTextStyle}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap"
                           Style="{StaticResource BodySecondaryTextStyle}"
                           Margin="10,2,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ShortcutGroupTemplate">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,18,18" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextStyle}" />
                    <TextBlock Text="{Binding Blurb}" Style="{StaticResource CaptionMutedTextStyle}"
                               TextWrapping="Wrap" Margin="0,3,0,14" />
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  ItemTemplate="{StaticResource ShortcutRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <DockPanel>

            <!-- header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBarBrush}"
                    Padding="20,14" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <pb:Icon Data="{StaticResource Icon.Help}" Width="16" Height="16"
                                 Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SubtitleTextStyle}" />
                            <TextBlock Style="{StaticResource CaptionMutedTextStyle}" Margin="0,3,0,0"
                                       Text="Every edit here is undoable with Ctrl+Z. Press Esc or F1 to close." />
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource SmallIconButtonStyle}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Click="OnClose" ToolTip="Close  (Esc)">
                        <pb:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- The map itself: two columns of independently stacked cards. Each column shares the
                 width evenly, so the whole table is on screen at once and nothing is clipped. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="20,20,2,20">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}"
                                          ItemTemplate="{StaticResource ShortcutGroupTemplate}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
