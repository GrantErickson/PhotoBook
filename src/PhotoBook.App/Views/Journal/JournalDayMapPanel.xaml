<UserControl x:Class="PhotoBook.App.Views.Journal.JournalDayMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pb="clr-namespace:PhotoBook.App.Controls"
             xmlns:conv="clr-namespace:PhotoBook.App.Converters"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True">

    <!--
        Where the journal text landed (doc 11 §"Import Report UI", ambient surfacing).

        The report says whether a day's text has a date; this says whether it has a home. A dated
        entry that no page carries is invisible in the editor and identical to no entry at all in the
        PDF, so those days get the amber treatment and everything else stays quiet.
    -->

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:CountToVisibilityConverter x:Key="ZeroToVisibility" Invert="True" />

        <!-- A page chip: the book-wide page number, clickable through to the page itself. -->
        <DataTemplate x:Key="PageChipTemplate">
            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,6,0" Padding="10,4"
                    MinWidth="0" MinHeight="0" ToolTip="{Binding Detail}"
                    Command="{Binding DataContext.OpenPageCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <pb:Icon Data="{StaticResource Icon.SinglePage}" Width="12" Height="12"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource NumericTextStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- One day. The left rail is the date; the body is the text and where it went. -->
        <DataTemplate x:Key="DayTemplate">
            <Border x:Name="Card" Style="{StaticResource WellStyle}" Padding="14,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Width="46" Margin="0,0,14,0">
                        <TextBlock x:Name="DayNumber" Text="{Binding DayLabel}"
                                   Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="{Binding WeekdayLabel}" Style="{StaticResource MicroTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}"
                                   Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="No journal text for this day" Style="{StaticResource BodySecondaryTextStyle}"
                                   Visibility="{Binding HasText, Converter={StaticResource InverseBoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="Status" Text="{Binding StatusLabel}"
                                       Style="{StaticResource CaptionMutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource CaptionMutedTextStyle}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource PageChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHomeless}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource AmberFlagWashBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AmberFlagBrush}" />
                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource AmberFlagBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasText}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.6" />
                    <Setter TargetName="DayNumber" Property="Foreground"
                            Value="{StaticResource TextTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}" Background="{DynamicResource SurfaceBrush}">
        <DockPanel>

            <!-- ============================================================ header -->
            <Border DockPanel.Dock="Top" Padding="18,14"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallIconButtonStyle}" ToolTip="Previous month"
                                Command="{Binding PreviousMonthCommand}">
                            <pb:Icon Data="{StaticResource Icon.ChevronLeft}" Width="13" Height="13" />
                        </Button>
                        <TextBlock Text="{Binding MonthLabel}" MinWidth="150" TextAlignment="Center"
                                   Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center"
                                   Margin="6,0,6,0" />
                        <Button Style="{StaticResource SmallIconButtonStyle}" ToolTip="Next month"
                                Command="{Binding NextMonthCommand}">
                            <pb:Icon Data="{StaticResource Icon.ChevronRight}" Width="13" Height="13" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource AmberFlagWashBrush}"
                                Visibility="{Binding HomelessDayCount, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Style="{StaticResource MicroTextStyle}"
                                       Foreground="{DynamicResource AmberFlagBrush}"
                                       Text="{Binding HomelessBadgeLabel}" />
                        </Border>
                    </StackPanel>

                    <CheckBox Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding ShowDaysWithoutText}"
                              Content="Show days without text" />
                </Grid>
            </Border>

            <!-- ======================================================= summary line -->
            <Border DockPanel.Dock="Top" Padding="18,10"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding SummarySentence}" Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- =============================================================== days -->
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,14,18">
                    <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayTemplate}" />
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Days.Count, Converter={StaticResource ZeroToVisibility}}">
                    <pb:Icon Data="{StaticResource Icon.Calendar}" Width="26" Height="26"
                             HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Style="{StaticResource ParagraphTextStyle}" TextAlignment="Center" Margin="0,12,0,0"
                               MaxWidth="320"
                               Text="Nothing on any day of this month — no photographs and no journal text." />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
