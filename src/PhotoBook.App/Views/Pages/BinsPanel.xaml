<UserControl x:Class="PhotoBook.App.Views.Pages.BinsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:pb="clr-namespace:PhotoBook.App.Controls"
             xmlns:conv="clr-namespace:PhotoBook.App.Converters"
             xmlns:svc="clr-namespace:PhotoBook.App.Services">

    <!--
        The bin panel (doc 09 §3.5, R10/R12/R13/R17).

        Three bins in one dockable panel: Unplaced, Upcoming, and the Outside-book tray. It docks to
        the bottom (a horizontal filmstrip) or to either side (a vertical list); the choice and the
        size are per-user preferences persisted outside the project (R13).

        Every tile is a drag source for the page canvas and the panel itself is a drop target: a
        photo dragged out of a slot and dropped here is unplaced, leaving an amber hole behind.
    -->

    <UserControl.Resources>
        <conv:BinDockToOrientationConverter x:Key="DockToOrientation" />
        <conv:PositiveCountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:NonEmptyStringToVisibilityConverter x:Key="TextToVisibility" />
        <sys:Double x:Key="SizeAuto">NaN</sys:Double>

        <!-- The shared bin context menu (doc 09 §3.5: the placed-photo menu, plus Exclude). -->
        <ContextMenu x:Key="BinItemMenu">
            <MenuItem Header="Change date…"
                      Command="{Binding PlacementTarget.Tag.ChangeDateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Adjust…"
                      Command="{Binding PlacementTarget.Tag.AdjustCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Set tier…"
                      Command="{Binding PlacementTarget.Tag.SetTierCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Go to this photo's page"
                      Command="{Binding PlacementTarget.Tag.JumpToPageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.HasPageBadge, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
            <Separator />
            <MenuItem Header="Exclude from book"
                      ToolTip="The photo leaves the book for good — even a re-scan or OneDrive re-sync will not bring it back. The original file stays in originals/, and Ctrl+Z undoes this."
                      Command="{Binding PlacementTarget.Tag.ExcludeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- Bottom dock: a square filmstrip tile, badges on a scrim so they read on any photo. -->
        <DataTemplate x:Key="BinTileTemplate">
            <Grid Width="64" Height="64" Margin="3"
                  ToolTip="{Binding Tooltip}"
                  ContextMenu="{StaticResource BinItemMenu}"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border CornerRadius="5" Background="{DynamicResource ThumbnailPlaceholderBrush}"
                        SnapsToDevicePixels="True" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                        <Border VerticalAlignment="Bottom" Height="18" CornerRadius="0,0,5,5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#B8000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="5,0,5,4" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding PageBadge}" Style="{StaticResource MicroTextStyle}"
                                           Foreground="#E8FFFFFF" HorizontalAlignment="Left"
                                           Visibility="{Binding HasPageBadge, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding YearBadge}" Style="{StaticResource MicroTextStyle}"
                                           Foreground="{DynamicResource AmberFlagBrush}" HorizontalAlignment="Left"
                                           Visibility="{Binding IsOutsideTray, Converter={StaticResource BoolToVisibility}}" />
                                <Border CornerRadius="3" Padding="4,0,4,1" HorizontalAlignment="Right"
                                        Background="{Binding EffectiveTier, Converter={StaticResource TierToBrush}}">
                                    <TextBlock Text="{Binding TierLabel}" Style="{StaticResource MicroTextStyle}"
                                               Foreground="#FF101010" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Side dock: a list row, because a 200 px column reads better as a list than a grid. -->
        <DataTemplate x:Key="BinRowTemplate">
            <Grid Margin="1,2"
                  ToolTip="{Binding Tooltip}"
                  ContextMenu="{StaticResource BinItemMenu}"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="64" Height="48" CornerRadius="4"
                        Background="{DynamicResource ThumbnailPlaceholderBrush}"
                        SnapsToDevicePixels="True" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Style="{StaticResource TruncatingTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border CornerRadius="3" Padding="4,0,4,1" Margin="0,0,6,0"
                                Background="{Binding EffectiveTier, Converter={StaticResource TierToBrush}}">
                            <TextBlock Text="{Binding TierLabel}" Style="{StaticResource MicroTextStyle}"
                                       Foreground="#FF101010" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding PageBadge}" Style="{StaticResource MicroTextStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Visibility="{Binding HasPageBadge, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding DayDisplay}" Style="{StaticResource CaptionMutedTextStyle}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="FilmstripPanel">
            <VirtualizingStackPanel Orientation="Horizontal" IsItemsHost="True" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel Orientation="Vertical" IsItemsHost="True" />
        </ItemsPanelTemplate>

        <!-- One ListBox, two personalities; the dock edge decides which. -->
        <Style x:Key="BinListStyle" TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="ItemTemplate" Value="{StaticResource BinRowTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource ListPanel}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBottomDock}" Value="True">
                    <Setter Property="ItemTemplate" Value="{StaticResource BinTileTemplate}" />
                    <Setter Property="ItemsPanel" Value="{StaticResource FilmstripPanel}" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A segment of the Unplaced | Upcoming | Outside switch. -->
        <Style x:Key="BinSegmentStyle" TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource SegmentedToggleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,3,10,4" />
        </Style>
    </UserControl.Resources>

    <!-- The panel takes its size from the persisted preference, on whichever axis it is docked. -->
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Height" Value="{StaticResource SizeAuto}" />
            <Setter Property="Width" Value="{StaticResource SizeAuto}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBottomDock}" Value="True">
                    <Setter Property="Height" Value="{Binding Settings.BinBottomHeight}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBottomDock}" Value="False">
                    <Setter Property="Width" Value="{Binding Settings.BinSideWidth}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border x:Name="Root" Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            AllowDrop="True"
            DragOver="OnPanelDragOver" DragLeave="OnPanelDragLeave" Drop="OnPanelDrop">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLeftDock}" Value="True">
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRightDock}" Value="True">
                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <DockPanel>

                <!-- resize grip: drags the persisted bin size on the docked axis -->
                <Border x:Name="Grip" Background="Transparent"
                        MouseLeftButtonDown="OnGripPressed" MouseMove="OnGripMoved"
                        MouseLeftButtonUp="OnGripReleased">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="DockPanel.Dock" Value="Top" />
                            <Setter Property="Height" Value="5" />
                            <Setter Property="Cursor" Value="SizeNS" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLeftDock}" Value="True">
                                    <Setter Property="DockPanel.Dock" Value="Right" />
                                    <Setter Property="Height" Value="{StaticResource SizeAuto}" />
                                    <Setter Property="Width" Value="5" />
                                    <Setter Property="Cursor" Value="SizeWE" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRightDock}" Value="True">
                                    <Setter Property="DockPanel.Dock" Value="Left" />
                                    <Setter Property="Height" Value="{StaticResource SizeAuto}" />
                                    <Setter Property="Width" Value="5" />
                                    <Setter Property="Cursor" Value="SizeWE" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- ================================================== header -->
                <DockPanel DockPanel.Dock="Top" Margin="10,4,8,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="DockPanel.Dock" Value="Bottom" />
                                <Setter Property="Margin" Value="0,8,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBottomDock}" Value="True">
                                        <Setter Property="DockPanel.Dock" Value="Right" />
                                        <Setter Property="Margin" Value="10,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                                      ToolTip="Dock the bin along the bottom"
                                      IsChecked="{Binding IsBottomDock, Mode=OneWay}"
                                      Command="{Binding SetDockCommand}"
                                      CommandParameter="{x:Static svc:BinDock.Bottom}">
                            <pb:Icon Data="{StaticResource Icon.DockBottom}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource IconToggleButtonStyle}" Margin="2,0,0,0"
                                      ToolTip="Dock the bin to the left"
                                      IsChecked="{Binding IsLeftDock, Mode=OneWay}"
                                      Command="{Binding SetDockCommand}"
                                      CommandParameter="{x:Static svc:BinDock.Left}">
                            <pb:Icon Data="{StaticResource Icon.DockSide}" RenderTransformOrigin="0.5,0.5">
                                <pb:Icon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </pb:Icon.RenderTransform>
                            </pb:Icon>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource IconToggleButtonStyle}" Margin="2,0,0,0"
                                      ToolTip="Dock the bin to the right"
                                      IsChecked="{Binding IsRightDock, Mode=OneWay}"
                                      Command="{Binding SetDockCommand}"
                                      CommandParameter="{x:Static svc:BinDock.Right}">
                            <pb:Icon Data="{StaticResource Icon.DockSide}" />
                        </ToggleButton>
                        <Button Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0"
                                ToolTip="Hide the bin (B)" Command="{Binding ToggleVisibleCommand}">
                            <pb:Icon Data="{StaticResource Icon.Close}" />
                        </Button>
                    </StackPanel>

                    <Border>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource SegmentedGroupStyle}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="DockPanel.Dock" Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBottomDock}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="DockPanel.Dock" Value="Left" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="{Binding Settings.BinDock, Converter={StaticResource DockToOrientation}}">
                            <ToggleButton Style="{StaticResource BinSegmentStyle}"
                                          IsChecked="{Binding Tab, Converter={StaticResource EqualityToBool},
                                                      ConverterParameter=Unplaced, Mode=OneWay}"
                                          Command="{Binding SelectTabCommand}"
                                          CommandParameter="{x:Static svc:BinTab.Unplaced}"
                                          ToolTip="Photos of this month that are on no page">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Unplaced" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ChipStyle}" Margin="7,0,0,0" Padding="6,0,6,1"
                                            Visibility="{Binding UnplacedCount, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding UnplacedCount}" Style="{StaticResource MicroTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource BinSegmentStyle}"
                                          IsChecked="{Binding Tab, Converter={StaticResource EqualityToBool},
                                                      ConverterParameter=Upcoming, Mode=OneWay}"
                                          Command="{Binding SelectTabCommand}"
                                          CommandParameter="{x:Static svc:BinTab.Upcoming}"
                                          ToolTip="Photos on later pages of this chapter — drag one here to pull it forward">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Upcoming" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ChipStyle}" Margin="7,0,0,0" Padding="6,0,6,1"
                                            Visibility="{Binding UpcomingCount, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding UpcomingCount}" Style="{StaticResource MicroTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource BinSegmentStyle}"
                                          IsChecked="{Binding Tab, Converter={StaticResource EqualityToBool},
                                                      ConverterParameter=Outside, Mode=OneWay}"
                                          Command="{Binding SelectTabCommand}"
                                          CommandParameter="{x:Static svc:BinTab.Outside}"
                                          ToolTip="Photos dated outside the book's year — they wait here instead of disappearing">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Outside year" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource AmberBadgeStyle}" Margin="7,0,0,0" Padding="6,0,6,1"
                                            Visibility="{Binding OutsideCount, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding OutsideCount}" Style="{StaticResource MicroTextStyle}"
                                                   Foreground="{DynamicResource AmberFlagTextBrush}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!--
                        The bottom dock is only 160 px tall, so its middle slot carries one line:
                        the R17 permanence notice normally, and the last action's note when there
                        is one. The side dock has room to show both properly.
                    -->
                    <Grid Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis"
                                   Text="Remove from bin = exclude: gone from the book for good, kept on disk."
                                   ToolTip="Right-click a photo and choose Exclude from book. It leaves every bin, grid and export and is never resurrected by a re-scan or OneDrive re-sync — but the original file stays in the project's originals/ folder, and Ctrl+Z undoes it.">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionMutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBottomDock}" Value="True" />
                                                <Condition Binding="{Binding Status}" Value="" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Status}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBottomDock}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBottomDock}" Value="True" />
                                                <Condition Binding="{Binding Status}" Value="" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <!-- ============================================ status note (side dock) -->
                <TextBlock DockPanel.Dock="Top" Margin="12,0,12,6" Text="{Binding Status}"
                           TextWrapping="Wrap" ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionTextStyle}">
                            <Setter Property="Visibility"
                                    Value="{Binding Status, Converter={StaticResource TextToVisibility}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBottomDock}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ======================================= permanence notice (R17), side dock -->
                <TextBlock DockPanel.Dock="Bottom" Margin="12,4,12,8" TextWrapping="Wrap"
                           Text="Remove from bin = exclude: gone from the book for good, kept on disk."
                           ToolTip="Right-click a photo and choose Exclude from book. It leaves every bin, grid and export and is never resurrected by a re-scan or OneDrive re-sync — but the original file stays in the project's originals/ folder, and Ctrl+Z undoes it.">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionMutedTextStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBottomDock}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ================================================== items -->
                <Grid>
                    <ListBox x:Name="BinList" Style="{StaticResource BinListStyle}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             PreviewMouseLeftButtonDown="OnItemsPressed"
                             PreviewMouseMove="OnItemsMoved"
                             Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- Empty state, bottom dock: one compact line so a 160 px filmstrip never clips. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="16,0" MaxWidth="620">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEmpty}" Value="True" />
                                            <Condition Binding="{Binding IsBottomDock}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <pb:Icon Data="{StaticResource Icon.Bin}" Width="16" Height="16"
                                 Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource BodySecondaryTextStyle}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource CaptionMutedTextStyle}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding EmptyDetail}" />
                    </StackPanel>

                    <!-- Empty state, side dock: the column has room to explain properly. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEmpty}" Value="True" />
                                            <Condition Binding="{Binding IsBottomDock}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <pb:Icon Data="{StaticResource Icon.Bin}" Width="22" Height="22"
                                 Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource BodySecondaryTextStyle}"
                                   Margin="0,9,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource CaptionMutedTextStyle}"
                                   Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- The drop ring: a photo dragged out of a slot and released here is unplaced (§3.2). -->
            <Border x:Name="DropRing" IsHitTestVisible="False" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                    Background="{DynamicResource AccentWashBrush}" CornerRadius="4" Margin="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <pb:Icon Data="{StaticResource Icon.Bin}" Width="20" Height="20"
                             Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop to unplace — the slot is flagged empty"
                               Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
