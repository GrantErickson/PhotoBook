<UserControl x:Class="PhotoBook.App.Views.Pages.LayoutCommandsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pb="clr-namespace:PhotoBook.App.Controls"
             xmlns:conv="clr-namespace:PhotoBook.App.Converters"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}" Padding="12,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <TextBlock Text="Auto-layout" Style="{StaticResource SectionLabelTextStyle}"
                       Margin="2,0,12,0" VerticalAlignment="Center" />

            <!-- 1. this day (doc 09 §3.8.2) -->
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LayoutDayCommand}"
                    ToolTip="Re-run the engine for this page's day only. Its pages may merge or split.">
                <StackPanel Orientation="Horizontal">
                    <pb:Icon Data="{StaticResource Icon.Calendar}" VerticalAlignment="Center" />
                    <TextBlock Text="Lay out this day" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource ChipStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDayLabel}" Style="{StaticResource MicroTextStyle}" />
                    </Border>
                </StackPanel>
            </Button>

            <!-- 2. rest of chapter (doc 09 §3.8.1) — always confirms first -->
            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                    Command="{Binding LayoutRestOfChapterCommand}"
                    ToolTip="Regenerate every unpinned page from here to the end of the chapter. You will be shown the exact page numbers first.">
                <StackPanel Orientation="Horizontal">
                    <pb:Icon Data="{StaticResource Icon.Pages}" VerticalAlignment="Center" />
                    <TextBlock Text="Auto-layout rest of chapter" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 3. insert pages for the unplaced bin (doc 09 §3.8.3) -->
            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                    Command="{Binding InsertUnplacedPagesCommand}"
                    ToolTip="Build new pages for everything in the Unplaced bin and splice them in by date. Existing pages are not modified.">
                <StackPanel Orientation="Horizontal">
                    <pb:Icon Data="{StaticResource Icon.PhotoPlus}" VerticalAlignment="Center" />
                    <TextBlock Text="Insert pages for unplaced" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource AmberBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding UnplacedCount, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="{Binding UnplacedCount}" Style="{StaticResource MicroTextStyle}"
                                   Foreground="{DynamicResource AmberFlagTextBrush}" />
                    </Border>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource VerticalDividerStyle}" Margin="14,4,14,4"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <!-- the engine is running: doc 09 §6 asks for visible progress inside 100 ms -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="90" Height="3" VerticalAlignment="Center" />
                <TextBlock Text="Laying out…" Margin="10,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource CaptionMutedTextStyle}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Margin="14,0,0,0" VerticalAlignment="Center"
                       MaxWidth="420" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionMutedTextStyle}"
                       ToolTip="{Binding StatusMessage}" />
        </StackPanel>
    </Border>
</UserControl>
