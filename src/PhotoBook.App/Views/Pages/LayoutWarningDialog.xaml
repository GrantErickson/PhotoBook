<Window x:Class="PhotoBook.App.Views.Pages.LayoutWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pb="clr-namespace:PhotoBook.App.Controls"
        xmlns:conv="clr-namespace:PhotoBook.App.Converters"
        Title="Auto-layout"
        Width="620" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:LayoutPageFateToBrushConverter x:Key="FateFill" />
        <conv:LayoutPageFateToBrushConverter x:Key="FateText" Foreground="True" />
        <conv:LayoutPageFateToStrokeConverter x:Key="FateStroke" />
    </Window.Resources>

    <!-- AllowsTransparency lets the modal cast the app's own elevation shadow rather than a
         Win32 frame; the margin is the shadow's breathing room. -->
    <Border Margin="18" Background="{DynamicResource SurfaceOverlayBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}" Effect="{StaticResource ElevationHigh}">
        <DockPanel>

            <!-- ============================================================ header -->
            <Border DockPanel.Dock="Top" Padding="22,18,22,16" MouseLeftButtonDown="OnHeaderDrag"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource WarningWashBrush}" VerticalAlignment="Top">
                        <pb:Icon Data="{StaticResource Icon.Warning}" Width="18" Height="18"
                                 Foreground="{DynamicResource WarningBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionMutedTextStyle}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource SmallIconButtonStyle}"
                            VerticalAlignment="Top" Command="{Binding CancelCommand}" ToolTip="Cancel">
                        <pb:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================================================ footer -->
            <Border DockPanel.Dock="Bottom" Padding="22,16" CornerRadius="0,0,10,10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                               Style="{StaticResource CaptionMutedTextStyle}"
                               Text="Ctrl+Z undoes the whole run in one step." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButtonStyle}" Content="Cancel" MinWidth="96"
                                Command="{Binding CancelCommand}" IsCancel="True" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" MinWidth="168"
                                Command="{Binding ConfirmCommand}" IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <pb:Icon Data="{StaticResource Icon.Pages}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConfirmLabel}" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================== body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,20">
                <StackPanel>

                    <!-- the sentence R16 demands, before anything runs -->
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource ParagraphTextStyle}"
                               MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <!-- the chapter map: one chip per page, coloured by its fate -->
                    <TextBlock Text="This chapter" Style="{StaticResource SectionLabelTextStyle}" Margin="0,18,0,8" />
                    <Border Style="{StaticResource WellStyle}" Padding="10,10,10,6">
                        <ItemsControl ItemsSource="{Binding Map}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,5,5" MinWidth="30" Height="26"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Background="{Binding Fate, Converter={StaticResource FateFill}}"
                                            BorderBrush="{Binding Fate, Converter={StaticResource FateStroke}}"
                                            BorderThickness="1"
                                            ToolTip="{Binding Explanation}">
                                        <TextBlock Text="{Binding Number}" Margin="8,0"
                                                   Style="{StaticResource NumericTextStyle}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{Binding Fate, Converter={StaticResource FateText}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- legend -->
                    <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Re-laid out" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionMutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource WarningWashBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" />
                            <TextBlock Text="Pinned" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionMutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentWashBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" />
                            <TextBlock Text="Detached" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionMutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceHighestBrush}" />
                            <TextBlock Text="Untouched" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionMutedTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- what survives -->
                    <Border Margin="0,18,0,0" Padding="14,11" CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Visibility="{Binding HasProtectedNote, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <pb:Icon Data="{StaticResource Icon.Pin}" VerticalAlignment="Top" Margin="0,2,0,0"
                                     Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="{Binding ProtectedNote}" Margin="10,0,0,0" TextWrapping="Wrap"
                                       MaxWidth="500" Style="{StaticResource BodySecondaryTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- the optional escape, off by default -->
                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding IncludePinnedPages}"
                              Content="{Binding IncludePinnedLabel}"
                              Visibility="{Binding CanIncludePinned, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Margin="26,6,0,0" TextWrapping="Wrap" MaxWidth="520"
                               Style="{StaticResource CaptionMutedTextStyle}"
                               Text="Detached pages are never re-laid out — a hand-built layout outranks the engine."
                               Visibility="{Binding HasDetachedPages, Converter={StaticResource BoolToVisibility}}" />

                    <!-- engine notes worth reading before agreeing -->
                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="The engine noticed" Style="{StaticResource SectionLabelTextStyle}" />
                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <pb:Icon Data="{StaticResource Icon.Info}" Width="14" Height="14"
                                                 VerticalAlignment="Top" Margin="0,2,0,0"
                                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding}" Margin="9,0,0,0" TextWrapping="Wrap"
                                                   MaxWidth="510" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
